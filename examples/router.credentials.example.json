{
  "schemaVersion": 1,
  "codexHome": "/Users/example/.codex",
  "providerId": "example_gateway",
  "upstreamBaseUrl": "https://gateway.example.invalid/api/v1",
  "listenPort": 8787,
  "observeRequestMetadata": false,
  "allowUnassignedThreadTitles": false,
  "projectRoutes": {
    "11111111-1111-4111-8111-111111111111": "validation-a",
    "22222222-2222-4222-8222-222222222222": "validation-b",
    "33333333-3333-4333-8333-333333333333": "controller"
  },
  "credentialRouting": {
    "globalCredential": {
      "keychainPath": "/Users/example/Library/Keychains/login.keychain-db",
      "service": "example-global-service",
      "account": "example-global-account"
    },
    "routeTargets": {
      "validation-a": {
        "upstreamBaseUrl": "https://project-gateway.example.invalid/region/v1",
        "credential": {
          "keychainPath": "/Users/example/Library/Keychains/login.keychain-db",
          "service": "example-project-a-service",
          "account": "example-project-a-account"
        }
      },
      "validation-b": {
        "upstreamBaseUrl": "https://project-gateway.example.invalid/region/v1",
        "credential": {
          "keychainPath": "/Users/example/Library/Keychains/login.keychain-db",
          "service": "example-project-b-service",
          "account": "example-project-b-account"
        }
      },
      "controller": {
        "upstreamBaseUrl": "https://gateway.example.invalid/api/v1",
        "credential": {
          "keychainPath": "/Users/example/Library/Keychains/login.keychain-db",
          "service": "example-global-service",
          "account": "example-global-account"
        }
      }
    }
  }
}
