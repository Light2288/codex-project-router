#!/usr/bin/python3
import json, os, select, signal, socket, sys, time
if len(sys.argv) == 4 and sys.argv[1] == '--hold-port':
    while not os.path.exists(sys.argv[3]): time.sleep(.01)
    listener = socket.socket(); listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(('127.0.0.1', int(sys.argv[2]))); listener.listen(5)
    while True:
        c, _ = listener.accept(); c.close()
if sys.argv[1:] == ['--version']:
    with open(sys.argv[0] + '.version-started', 'w') as f: f.write(str(os.getpid()))
    if 'slow' in sys.argv[0]: time.sleep(3)
    print('v23.0.0' if 'wrong' in sys.argv[0] else 'v24.10.0')
    sys.exit(0)
if sys.argv[1:2] == ['--use-system-ca']: del sys.argv[1]
root = os.path.dirname(sys.argv[1])
with open(os.path.join(root, 'behavior.json')) as f: behavior = json.load(f)
if os.environ.get('NODE_OPTIONS') or os.environ.get('NODE_PATH') or os.environ.get('COMPANION_SECRET'):
    sys.exit(19)
with open(os.path.join(root, 'pid'), 'w') as f: f.write(str(os.getpid()))
with open(os.path.join(root, 'invocations'), 'a') as f: f.write(' '.join(sys.argv[1:]) + '\n')
if os.path.basename(sys.argv[1]) == 'managed-serve.js':
    if len(sys.argv) != 6 or sys.argv[2] != '--config' or sys.argv[4] != '--session': sys.exit(21)
    with open(sys.argv[3]) as f: cfg = json.load(f)
    mode = behavior.get('mode', 'valid')
    if mode == 'childExit': sys.exit(8)
    listener = socket.socket(); listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(('127.0.0.1', cfg['port'])); listener.listen(5)
    def stop(*_):
        listener.close()
        if mode == 'reusePort':
            with open(os.path.join(root, 'released'), 'w') as f: f.write('released')
            time.sleep(.25)
        sys.exit(0)
    signal.signal(signal.SIGTERM, stop)
    current_mode = 'off'
    def reply(frame):
        try: os.write(1, (json.dumps(frame) + '\n').encode())
        except OSError: pass
    frame = dict(schemaVersion=1, type='ready', sessionId=sys.argv[5],
                 context=dict(configPath=sys.argv[3], codexHome=cfg['home'], providerId='fixture', listenPort=cfg['port']), mode='off')
    if mode == 'unsupportedReady': frame['schemaVersion'] = 2
    if mode == 'wrongContextReady': frame['context']['providerId'] = 'wrong'
    if mode not in ['noReady', 'longOutput']: reply(frame)
    control_open = True; input_bytes = b''
    while True:
        if mode == 'longOutput':
            try: os.write(1, b'SENTINEL_PRIVATE' * 8192)
            except OSError: pass
            try: os.write(2, b'SENTINEL_PRIVATE' * 8192)
            except OSError: pass
        ready, _, _ = select.select([listener] + ([0] if control_open else []), [], [], .05)
        if listener in ready:
            c, _ = listener.accept(); c.close()
        if 0 in ready:
            chunk = os.read(0, 4096)
            if not chunk: control_open = False; continue
            input_bytes += chunk
            while b'\n' in input_bytes:
                line, input_bytes = input_bytes.split(b'\n', 1)
                command = json.loads(line)
                with open(os.path.join(root, 'commands'), 'a') as f: f.write(json.dumps(command) + '\n')
                if command['action'] == 'set_mode':
                    current_mode = command['mode']
                    with open(os.path.join(root, 'router-mode'), 'w') as f: f.write(current_mode)
                    if mode == 'modeTimeout': continue
                    if mode == 'controlLoss': os.close(1); continue
                reply(dict(schemaVersion=1, type='mode', sessionId=sys.argv[5], requestId=command['requestId'], mode=current_mode))
if len(sys.argv) > 2 and sys.argv[2] == 'serve':
    with open(sys.argv[4]) as f: cfg = json.load(f)
    if behavior.get('mode') == 'childExit': sys.exit(8)
    listener = socket.socket(); listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(('127.0.0.1', cfg['port'])); listener.listen(5); listener.settimeout(.05)
    def stop(*_):
        listener.close()
        if behavior.get('mode') == 'reusePort':
            with open(os.path.join(root, 'released'), 'w') as f: f.write('released')
            time.sleep(.25)
        sys.exit(0)
    signal.signal(signal.SIGTERM, stop)
    while True:
        if behavior.get('mode') == 'longOutput':
            os.write(1, b'SENTINEL_PRIVATE' * 8192); os.write(2, b'SENTINEL_PRIVATE' * 8192)
        try:
            c, _ = listener.accept(); c.close()
        except socket.timeout: pass
request = json.load(sys.stdin)
mode = behavior.get('mode', 'valid')
if mode == 'heldMutation' and request['action'] != 'inspect':
    with open(os.path.join(root, 'mutation-started'), 'w') as f: f.write('started')
    while not os.path.exists(os.path.join(root, 'release-mutation')): time.sleep(.01)
    with open(os.path.join(root, 'provider-state'), 'w') as f: f.write('router')
if mode == 'stall' or (mode == 'mutationStall' and request['action'] != 'inspect'):
    time.sleep(6.3 if mode == 'mutationStall' else 30)
if mode == 'stderr': os.write(2, b'SENTINEL_PRIVATE' * 100000)
if mode == 'unknown':
    print(json.dumps(dict(schemaVersion=1, ok=True, result=dict(configuration=dict(state='unknown'), provider=dict(state='unknown', recoveryRequired=False, proxyReady=True, recordPhase='none'), catalog=dict(state='ready', entries=[])))))
    sys.exit(0)
if mode == 'malformed': print('SENTINEL_PRIVATE'); sys.exit(0)
if request['action'] == 'inspect':
    config = request.get('configPath')
    if config:
        with open(config) as f: cfg = json.load(f)
        context = dict(configPath=config, codexHome=cfg['home'], providerId='fixture', listenPort=cfg['port'])
        ready = False
        if mode != 'unready':
            try:
                c = socket.create_connection(('127.0.0.1', cfg['port']), .05); c.close(); ready = True
            except OSError: pass
        provider_state = 'direct'
        if os.path.exists(os.path.join(root, 'provider-state')):
            with open(os.path.join(root, 'provider-state')) as f: provider_state = f.read()
        result = dict(configuration=dict(state='valid', path=config, mode='legacy'), context=context,
                      revision='fixture_revision', provider=dict(state=provider_state, recoveryRequired=provider_state == 'router', proxyReady=ready, recordPhase='active' if provider_state == 'router' else 'none'), catalog=dict(state='ready', entries=[]))
    else:
        result = dict(configuration=dict(state='missing'), provider=dict(state='unavailable', recoveryRequired=False, proxyReady=None, recordPhase='unavailable'), catalog=dict(state='ready', entries=[dict(id='A',name='Project',routeAlias=None,routeState='unmapped')]))
else: result = dict(state='active' if request['action'] == 'activate' else 'direct', changed=True, restartRequired=True)
if mode == 'delayedInspection' and request['action'] == 'inspect':
    with open(os.path.join(root, 'snapshot-captured'), 'w') as f: f.write('captured')
    while not os.path.exists(os.path.join(root, 'release-snapshot')): time.sleep(.01)
if mode == 'overflow' and request['action'] == 'inspect':
    result['catalog']['entries'] = [dict(id='A', name='SENTINEL_PRIVATE' * 100000, routeAlias=None, routeState='unmapped')]
print(json.dumps(dict(schemaVersion=1, ok=True, result=result)))
sys.exit(9 if mode == 'exitFailure' else 0)
