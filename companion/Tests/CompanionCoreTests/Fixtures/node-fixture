#!/usr/bin/python3
import json, os, select, signal, socket, sys, time
if len(sys.argv) == 4 and sys.argv[1] == '--hold-port':
    while not os.path.exists(sys.argv[3]): time.sleep(.01)
    listener = socket.socket(); listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(('127.0.0.1', int(sys.argv[2]))); listener.listen(5)
    while True:
        c, _ = listener.accept(); c.close()
if sys.argv[1:] == ['--version']:
    with open(sys.argv[0] + '.version-started', 'w') as f: f.write(str(os.getpid()))
    if 'slow' in sys.argv[0]: time.sleep(3)
    print('v23.0.0' if 'wrong' in sys.argv[0] else 'v24.10.0')
    sys.exit(0)
if sys.argv[1:2] == ['--use-system-ca']: del sys.argv[1]
root = os.path.dirname(sys.argv[1])
def assignment_summary():
    return dict(kind='inherited', account=dict(id='11111111-1111-4111-8111-111111111111', displayName='Synthetic'))
def assignment_intent(change):
    return dict(schemaVersion=1, operationId=change['operationId'], context=change['expectedContext'], projectId=change['projectId'],
                accountId=change['accountId'], checkpointName='assignment-checkpoint-' + change['operationId'].lower() + '.json',
                beforeRevision='a'*64, beforeIdentity='b'*64, candidateRevision='c'*64, candidateIdentity='d'*64)
def assignment_state(context, project, change=None, live=False):
    revision, identity = ('c'*64, 'd'*64) if change else ('a'*64, 'b'*64)
    return dict(context=context, savedState='ready', savedRevision=revision, savedIdentity=identity, savedFingerprint='e'*64,
                catalogRevision='f'*64, runningRevision=revision if live else None, runningIdentity=identity if live else None,
                runningFingerprint='e'*64 if live else None, mode='off' if live else None, projectId=project,
                savedAssignment=assignment_summary() if project else None, runningAssignment=assignment_summary() if live and project else None,
                intent=assignment_intent(change) if change else None, lastAttempt=None)
def assignment_commit(change, live=False):
    intent = assignment_intent(change)
    return dict(context=change['expectedContext'], operationId=change['operationId'], projectId=change['projectId'], changed=True,
                beforeRevision='a'*64, candidateRevision='c'*64, savedRevision='c'*64, beforeIdentity='b'*64,
                candidateIdentity='d'*64, savedIdentity='d'*64, before=assignment_summary(), after=assignment_summary(),
                checkpointPath=os.path.join(os.path.dirname(change['configPath']),intent['checkpointName']), intent=intent,
                runningRevision='c'*64 if live else None, runningIdentity='d'*64 if live else None, runningFingerprint='e'*64 if live else None)
with open(os.path.join(root, 'behavior.json')) as f: behavior = json.load(f)
if os.environ.get('NODE_OPTIONS') or os.environ.get('NODE_PATH') or os.environ.get('COMPANION_SECRET'):
    sys.exit(19)
with open(os.path.join(root, 'pid'), 'w') as f: f.write(str(os.getpid()))
with open(os.path.join(root, 'invocations'), 'a') as f: f.write(' '.join(sys.argv[1:]) + '\n')
if os.path.basename(sys.argv[1]) == 'managed-serve.js':
    if len(sys.argv) != 6 or sys.argv[2] != '--config' or sys.argv[4] != '--session': sys.exit(21)
    with open(sys.argv[3]) as f: cfg = json.load(f)
    mode = behavior.get('mode', 'valid')
    if mode == 'childExit': sys.exit(8)
    listener = socket.socket(); listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(('127.0.0.1', cfg['port'])); listener.listen(5)
    def stop(*_):
        listener.close()
        if mode == 'reusePort':
            with open(os.path.join(root, 'released'), 'w') as f: f.write('released')
            time.sleep(.25)
        sys.exit(0)
    signal.signal(signal.SIGTERM, stop)
    current_mode = 'off'
    def reply(frame):
        try: os.write(1, (json.dumps(frame, separators=(',', ':')) + '\n').encode())
        except OSError: pass
    frame = dict(schemaVersion=1, type='ready', sessionId=sys.argv[5],
                 context=dict(configPath=sys.argv[3], codexHome=cfg['home'], providerId='fixture', listenPort=cfg['port']), mode='off')
    if mode != 'modeOnlyReady': frame['capabilities'] = ['project_assignments_v1']
    assignment_change = None
    if mode == 'unsupportedReady': frame['schemaVersion'] = 2
    if mode == 'wrongContextReady': frame['context']['providerId'] = 'wrong'
    if mode not in ['noReady', 'longOutput']: reply(frame)
    control_open = True; input_bytes = b''
    while True:
        if mode == 'longOutput':
            try: os.write(1, b'SENTINEL_PRIVATE' * 8192)
            except OSError: pass
            try: os.write(2, b'SENTINEL_PRIVATE' * 8192)
            except OSError: pass
        ready, _, _ = select.select([listener] + ([0] if control_open else []), [], [], .05)
        if listener in ready:
            c, _ = listener.accept(); c.close()
        if 0 in ready:
            chunk = os.read(0, 4096)
            if not chunk: control_open = False; continue
            input_bytes += chunk
            while b'\n' in input_bytes:
                line, input_bytes = input_bytes.split(b'\n', 1)
                command = json.loads(line)
                with open(os.path.join(root, 'commands'), 'a') as f: f.write(json.dumps(command) + '\n')
                if command['action'] in ['get_assignment', 'set_assignment']:
                    context = frame['context']
                    if command['action'] == 'set_assignment':
                        assignment_change = dict(command, configPath=sys.argv[3], operationId=command['requestId'])
                        with open(os.path.join(root, 'assignment-record'), 'w') as f: json.dump(assignment_change, f)
                        if mode == 'assignmentTimeout': continue
                        if mode == 'assignmentLoss': os.close(1); continue
                        reply(dict(schemaVersion=1,type='assignment_result',sessionId=sys.argv[5],requestId=command['requestId'],
                                   outcome='applied',code=None,commit=assignment_commit(assignment_change,True),
                                   state=assignment_state(context,command['projectId'],assignment_change,True)))
                    else:
                        if mode == 'assignmentReadExit': sys.exit(0)
                        state = assignment_state(context,command['projectId'],assignment_change,True)
                        state['mode'] = current_mode
                        if not assignment_change or command['operationId'] != assignment_change['operationId']: state['intent'] = None
                        reply(dict(schemaVersion=1,type='assignment_state',sessionId=sys.argv[5],requestId=command['requestId'],state=state))
                    continue
                if command['action'] == 'set_mode':
                    current_mode = command['mode']
                    with open(os.path.join(root, 'router-mode'), 'w') as f: f.write(current_mode)
                    if mode == 'modeTimeout': continue
                    if mode == 'controlLoss': os.close(1); continue
                reply(dict(schemaVersion=1, type='mode', sessionId=sys.argv[5], requestId=command['requestId'], mode=current_mode))
if len(sys.argv) > 2 and sys.argv[2] == 'serve':
    with open(sys.argv[4]) as f: cfg = json.load(f)
    if behavior.get('mode') == 'childExit': sys.exit(8)
    listener = socket.socket(); listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(('127.0.0.1', cfg['port'])); listener.listen(5); listener.settimeout(.05)
    def stop(*_):
        listener.close()
        if behavior.get('mode') == 'reusePort':
            with open(os.path.join(root, 'released'), 'w') as f: f.write('released')
            time.sleep(.25)
        sys.exit(0)
    signal.signal(signal.SIGTERM, stop)
    while True:
        if behavior.get('mode') == 'longOutput':
            os.write(1, b'SENTINEL_PRIVATE' * 8192); os.write(2, b'SENTINEL_PRIVATE' * 8192)
        try:
            c, _ = listener.accept(); c.close()
        except socket.timeout: pass
mode = behavior.get('mode', 'valid')
if mode in ['stdinDelayed', 'stdinTimeout', 'stdinCancelled', 'stdinEarlyExit']:
    with open(os.path.join(root, 'stdin-paused'), 'w') as f: f.write('paused')
    if mode == 'stdinEarlyExit':
        os.close(0)
        with open(os.path.join(root, 'stdin-response')) as f: response = json.load(f)
        print(json.dumps(dict(schemaVersion=1, ok=True, result=response))); sys.exit(0)
    if mode == 'stdinCancelled':
        deadline = time.monotonic() + 8
        while not os.path.exists(os.path.join(root, 'release-stdin')) and time.monotonic() < deadline: time.sleep(.01)
    else: time.sleep(1.5 if mode == 'stdinDelayed' else 6.3)
request = json.load(sys.stdin)
mode = behavior.get('mode', 'valid')
if request['action'] in ['assignment_state', 'assignment_commit']:
    context = request['expectedContext']
    record = os.path.join(root, 'assignment-record')
    if request['action'] == 'assignment_commit':
        with open(os.path.join(root, 'assignment-request'), 'w') as f: json.dump(request, f)
        if mode == 'assignmentHeld':
            with open(os.path.join(root, 'assignment-started'), 'w') as f: f.write('started')
            while not os.path.exists(os.path.join(root, 'release-assignment')): time.sleep(.01)
        if mode == 'assignmentRejected':
            print(json.dumps(dict(schemaVersion=1,ok=False,error=dict(code='ASSIGNMENT_CONFLICT',message='SENTINEL_PRIVATE')))); sys.exit(0)
        with open(record, 'w') as f: json.dump(request, f)
        if mode == 'assignmentLostReply': print('SENTINEL_PRIVATE'); sys.exit(0)
        if mode == 'assignmentBooleanSchema':
            print(json.dumps(dict(schemaVersion=True,ok=False,error=dict(code='ASSIGNMENT_CONFLICT',message='synthetic')))); sys.exit(0)
        result = assignment_commit(request)
    else:
        change = None
        if os.path.exists(record):
            with open(record) as f: change = json.load(f)
        result = assignment_state(context, request['projectId'], change)
        if not change or request['operationId'] != change['operationId']: result['intent'] = None
    print(json.dumps(dict(schemaVersion=1, ok=True, result=result))); sys.exit(0)
if mode == 'heldMutation' and request['action'] != 'inspect':
    with open(os.path.join(root, 'mutation-started'), 'w') as f: f.write('started')
    while not os.path.exists(os.path.join(root, 'release-mutation')): time.sleep(.01)
    with open(os.path.join(root, 'provider-state'), 'w') as f: f.write('router')
if mode == 'stall' or (mode == 'mutationStall' and request['action'] != 'inspect'):
    time.sleep(6.3 if mode == 'mutationStall' else 30)
if mode == 'stderr': os.write(2, b'SENTINEL_PRIVATE' * 100000)
if mode == 'unknown':
    print(json.dumps(dict(schemaVersion=1, ok=True, result=dict(configuration=dict(state='unknown'), provider=dict(state='unknown', recoveryRequired=False, proxyReady=True, recordPhase='none'), catalog=dict(state='ready', entries=[])))))
    sys.exit(0)
if mode == 'malformed': print('SENTINEL_PRIVATE'); sys.exit(0)
if request['action'] in ['setup_preview', 'setup_commit']:
    config = request['configPath']
    with open(config) as f: cfg = json.load(f)
    context = dict(configPath=config, codexHome=cfg['home'], providerId='fixture', listenPort=cfg['port'])
    ref = dict(keychainPath='/private/synthetic.keychain-db', service='synthetic', account='existing')
    account = dict(id='11111111-1111-4111-8111-111111111111', displayName='Existing', upstreamBaseUrl='https://example.invalid/api', credential=ref, sourceAlias=None)
    if request['action'] == 'setup_preview':
        result = dict(context=context, configurationRevision='a'*64, setupState='ready', sourceKind='accounts', accounts=[account], routeAccounts={}, incomingCredential=ref, defaultAccountId=account['id'], incomingHint=None, originalDirect=account)
        if mode == 'setupUnknownState': result['setupState'] = 'future'
        if mode == 'setupWrongContext': result['context']['configPath'] += '-wrong'
    else:
        with open(os.path.join(root, 'setup-request'), 'w') as f: json.dump(request, f)
        result = dict(context=context, operationId=request['operationId'], setupState='ready', configurationRevision='b'*64, checkpointPath=None, changed=True)
        if mode == 'setupLostReply': print('lost'); sys.exit(0)
    print(json.dumps(dict(schemaVersion=1, ok=True, result=result))); sys.exit(0)
if request['action'] == 'inspect':
    config = request.get('configPath')
    if config:
        with open(config) as f: cfg = json.load(f)
        context = dict(configPath=config, codexHome=cfg['home'], providerId='fixture', listenPort=cfg['port'])
        ready = False
        if mode != 'unready':
            try:
                c = socket.create_connection(('127.0.0.1', cfg['port']), .05); c.close(); ready = True
            except OSError: pass
        provider_state = 'direct'
        if os.path.exists(os.path.join(root, 'provider-state')):
            with open(os.path.join(root, 'provider-state')) as f: provider_state = f.read()
        result = dict(configuration=dict(state='valid', path=config, mode='accounts', setupState='ready'), context=context,
                      revision='fixture_revision', provider=dict(state=provider_state, recoveryRequired=provider_state == 'router', proxyReady=ready, recordPhase='active' if provider_state == 'router' else 'none'), catalog=dict(state='ready', entries=[]))
    else:
        result = dict(configuration=dict(state='missing'), provider=dict(state='unavailable', recoveryRequired=False, proxyReady=None, recordPhase='unavailable'), catalog=dict(state='ready', entries=[dict(id='A',name='Project',routeAlias=None,routeState='unmapped')]))
if request['action'] == 'inspect' and request.get('configPath'):
    if mode == 'setupRequired': result['configuration']['setupState'] = 'required'
    if mode == 'legacySetup': result['configuration'].update(mode='legacy', setupState='migration_required')
    if mode == 'wireUnknownSetup': result['configuration']['setupState'] = 'future'
    if mode == 'wireUnknownAssignment': result['catalog']['entries'] = [dict(id='A', name='Project', routeAlias=None, routeState='unmapped', assignmentKind='future')]
if request['action'] != 'inspect': result = dict(state='active' if request['action'] == 'activate' else 'direct', changed=True, restartRequired=True)
if mode == 'delayedInspection' and request['action'] == 'inspect':
    with open(os.path.join(root, 'snapshot-captured'), 'w') as f: f.write('captured')
    while not os.path.exists(os.path.join(root, 'release-snapshot')): time.sleep(.01)
if mode == 'overflow' and request['action'] == 'inspect':
    result['catalog']['entries'] = [dict(id='A', name='SENTINEL_PRIVATE' * 100000, routeAlias=None, routeState='unmapped')]
print(json.dumps(dict(schemaVersion=1, ok=True, result=result)))
sys.exit(9 if mode == 'exitFailure' or (mode == 'mutationExitFailure' and request['action'] != 'inspect') else 0)
